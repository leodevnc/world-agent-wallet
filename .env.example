# Default: no blockchain transactions, no API keys required.
WALLET_MODE=demo
WALLET_PORT=8787
WALLET_DATA_DIR=.local
WALLET_TIMEZONE=Asia/Seoul
# World ID owner verification (optional in demo, required for live x402).
# WORLD_APP_ID=app_...
# WORLD_RP_ID=rp_...
# WORLD_SIGNING_KEY=0x...
# WORLD_ACTION=agent-wallet-owner
# WORLD_ENVIRONMENT=staging
# Live mode also requires a registered, separately funded wallet and catalog.
# WALLET_MODE=x402
# WORLD_ENVIRONMENT=production
# WORLD_WALLET_PRIVATE_KEY=0x...
# WORLD_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
# WALLET_SERVICES_FILE=./services.live.json
